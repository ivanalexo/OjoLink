{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ojolink-resolver",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "send_metrics": false,
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "DEEP_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 2,
        "period": 60
      }
    }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  }
}
