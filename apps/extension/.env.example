# Copy to .env.local, which git ignores.

# Address of the OjoLink resolver that reveals where a short link leads.
# Leave it empty to build a package that reveals nothing and contacts no server.
# It must be https, or http on localhost for development.
WXT_RESOLVER_URL=

# Address of the page where people can donate. Leave it empty to show no donation link.
# It must be https.
WXT_DONATE_URL=
