{
  "name": "@ojolink/core",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json --noEmit && vitest run && node scripts/check-size.mjs",
    "size": "node scripts/check-size.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "tldts": "^7.5.4"
  }
}
